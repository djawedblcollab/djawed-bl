# Configuration Email (Example)
# Copiez ce fichier vers .env et remplissez avec vos informations

# Service d'email (gmail, outlook, yahoo, etc.)
EMAIL_SERVICE=gmail

# Votre adresse email
EMAIL_USER=djawedblcontact@gmail.com

# Mot de passe d'application (PAS votre mot de passe normal!)
# Pour Gmail: https://myaccount.google.com/apppasswords
EMAIL_PASS=votre-mot-de-passe-app

# IMPORTANT:
# - N'utilisez JAMAIS votre mot de passe normal
# - Créez un "mot de passe d'application" spécifique
# - Pour Gmail: Activez la validation en 2 étapes d'abord
# - Ajoutez .env au .gitignore pour ne pas le committer!
